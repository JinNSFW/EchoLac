  "A legend explains the bridge.": "8e6212062c1d745e30fb",
  "subdue": "1ef8eb98a302f24f8c95",
  "The bridge subdues a sea monster.": "e8b7850fe42e7dba6d44",
  "influence": "0eb4d87806f78475bfd6",
  "You can see Japanese influence here.": "8f1d018aa6bf49556f0a",
  "interaction": "18dbf88f75df6a38a8fe",
