  "staple": "b607c587480f01095376",
  "Mì Quảng is a local staple.": "3fae4da25ed47a53b6ad",
  "festive occasion": "3ae27620fd78a4bf82ff",
  "It is served on festive occasions.": "27bdbca1476ebeb54539",
  "regional identity": "95814232afde33d39e7e",
  "Food shows regional identity.": "99b9b91fbf126f12e7fa",
  "slice": "910cb91a615ba3fdf4c5",
  "Each slice keeps skin at both ends.": "972a074f3c03c0378811",
  "wrap": "8b63d5be7da60cc5cdc5",
  "Wrap the pork in rice paper.": "1a8b18a920de9696ae15",
