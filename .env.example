# Copy to .env (git-ignored) and fill in. Only the SERVER may read these.
# Set the same names in your host's "Environment variables" screen (Netlify / Vercel / Cloudflare).
# Never put a real value in this file, in index.html or in app.js.
ANTHROPIC_API_KEY=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
