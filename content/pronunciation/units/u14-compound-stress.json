{
  "id": "U14",
  "level": "B1",
  "band": "B1",
  "category": "word_stress",
  "kind": "stress",
  "prereq": [
    "U06"
  ],
  "title": {
    "vi": "Trọng âm từ ghép",
    "en": "Compound vs phrase stress"
  },
  "cando": {
    "vi": "Em nhấn đúng từ ghép như SEAfood, NIGHT market, BUS stop và phân biệt với cụm từ như old TOWN, green HOUSE.",
    "en": "I can say compounds like SEAfood, NIGHT market and BUS stop, and tell them from phrases like old TOWN and green HOUSE."
  },
  "why": [
    {
      "vi": "Trong tiếng Anh, từ ghép thường nhấn từ đầu (GREENhouse = nhà kính), còn cụm tính từ + danh từ thường nhấn từ sau (green HOUSE = ngôi nhà màu xanh). Chỉ khác chỗ nhấn là nghĩa đã khác.",
      "en": "In English, compounds usually stress the first part (GREENhouse = a place for plants), while adjective + noun phrases usually stress the last word (green HOUSE = a house that is green). Only the stress place changes the meaning.",
      "refs": [
        "[B6]"
      ]
    },
    {
      "vi": "Một nghiên cứu nhỏ ghi nhận người học nâng cao tiếng Anh gốc Việt có thể khớp được cao độ và độ to, nhưng chưa khớp được độ dài (nhịp) của âm tiết, nên bài này luyện cả ba.",
      "en": "A small study reports that advanced Vietnamese-background learners can match pitch and loudness but not syllable timing, so this unit practises all three.",
      "refs": [
        "[B6]"
      ]
    },
    {
      "vi": "Tiếng Việt có thanh điệu chứ không có trọng âm từ, nên học sinh thường nói các từ trong một cụm với độ nặng gần như nhau; đặt sai trọng âm là lỗi thường gặp ở người học Việt, và mức ưu tiên của bài này là P2.",
      "en": "Vietnamese uses tones, not word stress, so learners often give every word in a phrase similar weight; misplaced stress is a common error for Vietnamese learners, and this unit has priority P2.",
      "refs": [
        "[B3]",
        "[B13]"
      ]
    }
  ],
  "howTo": [
    {
      "vi": "Với từ ghép, vỗ mạnh ở từ đầu và nhẹ ở từ sau: SEA-food, SUN-set, BOOK-shop. Từ thứ hai ngắn và nhẹ.",
      "en": "For a compound, hit hard on the first part and lightly on the second: SEA-food, SUN-set, BOOK-shop. Keep the second part short and light."
    },
    {
      "vi": "Với cụm tính từ + danh từ, nhấn từ cuối: old TOWN, green HOUSE. Từ đầu nhẹ hơn và nhanh hơn.",
      "en": "For adjective + noun phrases, stress the last word: old TOWN, green HOUSE. Make the first word lighter and faster."
    },
    {
      "vi": "Nhấn bằng độ dài và độ to: kéo dài một chút và mở miệng rộng hơn ở âm tiết nhấn. Không đổi cao độ như dấu sắc.",
      "en": "Stress with length and loudness: hold the stressed syllable a little longer and open your mouth wider. Do not use pitch like a tone mark."
    },
    {
      "vi": "So sánh hai cách nói của cùng một chữ: GREENhouse (nhà kính) và green HOUSE (ngôi nhà màu xanh). Nghe và nói lại cả hai.",
      "en": "Compare two ways of saying the same letters: GREENhouse (for plants) and green HOUSE (a house that is green). Listen and say both."
    }
  ],
