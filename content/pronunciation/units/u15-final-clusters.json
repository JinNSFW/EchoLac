{
  "id": "U15",
  "level": "B2",
  "band": "B2-C1",
  "category": "cluster",
  "kind": "segmental",
  "prereq": [
    "U08",
    "U09"
  ],
  "title": {
    "vi": "Cụm phụ âm cuối",
    "en": "Final clusters"
  },
  "cando": {
    "vi": "Em giữ đủ mọi phụ âm ở cuối từ như texts, months, landmarks.",
    "en": "I can keep every consonant at the end of words like texts, months, landmarks."
  },
  "why": [
    {
      "vi": "Âm tiết tiếng Việt chuẩn chỉ kết thúc bằng một phụ âm, nên cụm cuối như /ksts/ trong texts thường bị rút gọn thành text hoặc tek. Việc bỏ một phần của cụm được báo cáo là lỗi thường gặp ở học sinh Việt.",
      "en": "Standard Vietnamese syllables end in only one consonant, so final clusters like /ksts/ in texts are often shortened to text or tek. Dropping part of a cluster is reported as a common error among Vietnamese learners.",
      "refs": [
        "[4]",
        "[14]"
      ]
    },
    {
      "vi": "Đuôi -s và -ed thường nằm ngay sau cụm (lamps, helped, months), nên khi bỏ chúng người nghe mất thông tin về số nhiều hoặc thì quá khứ. Các nghiên cứu được báo cáo thấy việc bỏ đuôi nhiều hơn sau phụ âm.",
      "en": "The -s and -ed endings often sit right after a cluster (lamps, helped, months), so dropping them loses plural or past-tense information. Studies report more ending omission after consonants.",
      "refs": [
        "[13]",
        "[2]"
      ]
    },
    {
      "vi": "Cặp như pass–past, bell–belt, ten–tent chỉ khác nhau ở một phụ âm cuối; thiếu âm đó làm hai từ trùng nhau. Phụ âm là nhóm âm cốt lõi để hiểu nhau trong tiếng Anh quốc tế, nên bài có ưu tiên cao (P1).",
      "en": "Pairs like pass–past, bell–belt, ten–tent differ only in one final consonant; leaving it out makes the two words collide. Consonants are core sounds for mutual intelligibility in international English, so this unit is high priority (P1).",
      "refs": [
        "[B16]",
        "[B15]"
      ]
    }
  ],
  "howTo": [
    {
      "vi": "Luyện từ cuối ra đầu: nói âm cuối, thêm một âm mỗi lần, như s, ts, kts, ɛkts, tɛkts. Dùng dãy luyện bên dưới.",
      "en": "Practise from the end: say the last sound, then add one sound each time, like s, ts, kts, ɛkts, tɛkts. Use the chain below."
    },
    {
      "vi": "Giữ đầu lưỡi gần nướu sau răng trên: /s/ thổi mảnh, rồi chạm lưỡi thành /t/ ngắn mà không buông thành nguyên âm.",
      "en": "Keep the tongue tip near the ridge behind the top teeth: blow a thin /s/, then touch a short /t/. No vowel after it."
    },
    {
      "vi": "Đừng chèn \"ờ\" giữa các phụ âm: lamps không phải \"lam-pờ-sờ\". Đặt tay trước miệng, /p/ và /s/ phải đến liền nhau.",
      "en": "Do not insert \"uh\" between consonants: lamps is not \"lam-puh-suh\". Join /p/ and /s/ with no gap."
    },
    {
      "vi": "Với pass–past: nói pass, giữ lưỡi gần nướu, rồi chạm lên nướu thêm /t/ ngắn, không rung cổ.",
      "en": "For pass–past: say pass, keep the tongue near the ridge, then touch up for a short /t/ with no voice."
    }
  ],
