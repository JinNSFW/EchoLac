  "contrasts": [
    {
      "id": "U16-c01",
      "wrongText": "I WANT TOO GO TOO THE BEACH. (every word strong, to = [tuː])",
      "rightText": "I WANT tuh GO tuh the BEACH. (to = weak [tə])",
      "note": {
        "vi": "Chữ to đọc đầy đủ \"tu\" làm câu nặng và đều. Thả lỏng môi, nói ngắn \"tờ\".",
        "en": "Saying to as a full \"too\" makes the sentence heavy and even. Relax the lips and say a short \"tuh\"."
      }
    },
    {
      "id": "U16-c02",
      "wrongText": "A cup OFF tea AND some fish. (of = [ɔf], and = [æn])",
      "rightText": "A CUP-uv-TEA-n-some FISH. (of = [əv], and = [ən] joined)",
      "note": {
        "vi": "Of nói như \"off\" và and nói như \"ản\" tách rời. Nối of vào từ trước (\"cup-uv\") và rút and thành \"-n\".",
        "en": "Of said like \"off\" and and said as a separate \"an\". Join of to the word before (\"cup-uv\") and shrink and to \"-n\"."
      }
    },
    {
      "id": "U16-c03",
      "wrongText": "I can swim. = I CAN swim. (can strong, sounds like can't)",
      "rightText": "I kn SWIM. (can weak) / I CAN'T swim. (can't strong)",
      "note": {
        "vi": "Nếu can nhấn mạnh, người nghe dễ hiểu thành can't. Câu khẳng định: can yếu, từ chính swim mạnh.",
        "en": "If can is stressed, listeners may hear can't. In a positive sentence keep can weak and make the content word swim strong."
      }
    }
  ],
  "chain": [
    {
      "text": "I want to go to the beach.",
      "shadow": [
        {
          "vi": "Nghe câu mẫu hai lần, chỉ chú ý từ nào to rõ (want, go, beach) và từ nào rất nhẹ (to, the).",
          "en": "Listen to the model twice and notice only which words are loud (want, go, beach) and which are very light (to, the)."
        },
        {
          "vi": "Ngân nga (hum) nhịp mạnh-nhẹ của câu, không nói chữ.",
          "en": "Hum the strong-light beat of the sentence without words."
        },
        {
          "vi": "Thì thầm cùng lúc với âm thanh mẫu, bắt chước hình dạng, không bắt chước giọng.",
          "en": "Whisper along with the audio, copying the shape, not the voice."
        },
        {
          "vi": "Nói thành tiếng cùng với âm thanh mẫu; nhìn đường cao độ và khớp hình dạng.",
          "en": "Speak aloud with the audio; watch the pitch line and match its shape."
        },
        {
          "vi": "Nói một mình, không có âm thanh; so sánh với đường cao độ của mẫu.",
          "en": "Speak alone with no audio; compare with the model pitch line."
        }
      ],
      "note": {
        "vi": "Bắt chước hình dạng đường cao độ, không bắt chước giọng của người nói mẫu.",
        "en": "Copy the shape of the pitch line, not the model speaker's voice."
      }
    }
