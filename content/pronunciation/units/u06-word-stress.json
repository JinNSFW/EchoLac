{
  "id": "U06",
  "level": "A2",
  "band": "A1-A2",
  "category": "word_stress",
  "kind": "stress",
  "prereq": [],
  "title": {
    "vi": "Trọng âm từ 2–3 âm tiết",
    "en": "Stress in 2–3 syllable words"
  },
  "cando": {
    "vi": "Em nhấn đúng âm tiết trong các từ 2–3 âm tiết như hotel, banana, coffee, market.",
    "en": "I can stress the right syllable in place and food words like hotel, banana, coffee and market."
  },
  "why": [
    {
      "vi": "Tiếng Việt có thanh điệu chứ không có trọng âm từ: mỗi âm tiết thường nặng như nhau. Vì vậy học sinh hay nói hotel hoặc computer với các âm tiết đều nhau, hay đặt nhấn sai chỗ (hoTEL → HOtel). Một nghiên cứu nhỏ (45 người) ghi nhận đặt sai trọng âm là lỗi thường gặp ở người học Việt.",
      "en": "Vietnamese uses tones, not word stress, so syllables usually carry equal weight. Learners often say hotel or computer with even syllables or stress the wrong one (hoTEL becomes HOtel). One small study (45 speakers) reports misplaced stress as a common error for Vietnamese learners.",
      "refs": [
        "[B3]",
        "[B4]"
      ]
    },
    {
      "vi": "Trọng âm đúng giúp người nghe hiểu và nhớ từ: một nghiên cứu cho thấy giáo viên và người nghe đánh giá cao hơn khi trọng âm chính đặt đúng. Âm tiết không nhấn thường được đọc ngắn và yếu hơn, hay thành /ə/ (banana: bə-NA-nə).",
      "en": "Correct stress helps listeners understand and remember a word: a study reports that listeners rate speech higher when the main stress is in the right place. Unstressed syllables are usually shorter and weaker, often /ə/ (banana: bə-NA-nə).",
      "refs": [
        "[B13]",
        "[9]"
      ]
    },
    {
      "vi": "Học sinh Việt thường giữ nguyên nguyên âm đầy đủ ở âm tiết không nhấn (được báo cáo ở cả người học nâng cao), nên mức ưu tiên của bài này là P2.",
      "en": "Vietnamese learners are often reported to keep full vowels in unstressed syllables, even at advanced level, so this unit has priority P2.",
      "refs": [
        "[9]",
        "[B7]"
      ]
    }
  ],
  "howTo": [
    {
      "vi": "Âm tiết được nhấn dài hơn và to hơn. Đặt tay dưới cằm: ở âm tiết đó miệng mở rộng hơn một chút.",
      "en": "The stressed syllable is longer and louder. Rest a hand under your chin: your mouth opens a bit wider on that syllable."
    },
    {
      "vi": "Gõ nhịp lên bàn: vỗ mạnh ở âm tiết nhấn, nhẹ ở các âm tiết còn lại. Với hotel: ho-TEL, vỗ nhẹ rồi mạnh.",
      "en": "Tap on the desk: hit hard on the stressed syllable and lightly on the others. For hotel: ho-TEL, light then hard."
    },
    {
      "vi": "Giữ âm tiết không nhấn thật ngắn và yếu, thường nói thành /ə/ (\"ờ\" ngắn): banana là bờ-NA-nờ, không phải ba-na-na đều nhau.",
      "en": "Keep unstressed syllables short and weak, often a quick \"uh\" /ə/: banana is buh-NA-nuh, not ba-na-na with equal beats."
    },
    {
      "vi": "Đừng đổi cao độ như dấu sắc hay dấu huyền của tiếng Việt. Nhấn bằng độ dài và độ to, giọng vẫn tự nhiên.",
      "en": "Do not use pitch like a Vietnamese tone mark. Stress with length and loudness, and keep your voice natural."
    },
    {
      "vi": "Nghe từ mẫu, nói lại, rồi so sánh. Với mỗi từ mới, tra xem nhấn âm tiết số mấy trước khi nói.",
      "en": "Listen to the model, say it back, then compare. For every new word, check which syllable is stressed before you speak."
    }
  ],
