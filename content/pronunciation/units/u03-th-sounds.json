{
  "id": "U03",
  "level": "A1",
  "band": "A1-A2",
  "category": "th",
  "kind": "segmental",
  "prereq": [],
  "title": {
    "vi": "Âm /θ/ và /ð/",
    "en": "The \"th\" sounds"
  },
  "cando": {
    "vi": "Em nói được /θ/ và /ð/ trong những từ quen thuộc.",
    "en": "I can say /θ/ and /ð/ in common words."
  },
  "why": [
    {
      "vi": "Tiếng Việt không có /θ/ và /ð/. Người học thường đọc /θ/ thành /t/ (think → \"tink\") hoặc /s/, và /ð/ thành /d/ hoặc /z/ (this → \"dis\", \"zis\"). Dữ liệu từ 10 bản ghi và 115 phiếu khảo sát người lớn.",
      "en": "Vietnamese has no /θ/ or /ð/. Learners often say /θ/ as /t/ (think → \"tink\") or /s/, and /ð/ as /d/ or /z/ (this → \"dis\", \"zis\"). Data came from 10 recordings and 115 questionnaires of adult learners.",
      "refs": [
        "[3]"
      ]
    },
    {
      "vi": "Chữ \"th\" trong tiếng Việt (như \"thở\") là âm /t/ bật hơi, không phải âm đặt lưỡi giữa hai hàm răng, nên chữ viết dễ đánh lừa.",
      "en": "The Vietnamese letters \"th\" (as in \"thở\") stand for an aspirated /t/, not a tongue-between-teeth sound, so the spelling can mislead.",
      "refs": [
        "[3]"
      ]
    },
    {
      "vi": "Theo Lingua Franca Core, /θ ð/ không thuộc nhóm âm cốt lõi cho việc hiểu nhau trong tiếng Anh quốc tế, nên bài này có mức ưu tiên thấp (P3) nhưng vẫn được dạy vì thường được kỳ vọng ở bài kiểm tra.",
      "en": "In the Lingua Franca Core, /θ ð/ are not core sounds for mutual intelligibility in international English, so this unit has low priority (P3), but it is still taught because tests and teachers often expect it.",
      "refs": [
        "[B16]"
      ]
    }
  ],
  "howTo": [
    {
      "vi": "Đặt đầu lưỡi nhẹ nhàng giữa hai hàm răng, đủ để nhìn thấy một chút đầu lưỡi trong gương.",
      "en": "Place the tongue tip lightly between your teeth, so you can see a little of it in a mirror."
    },
    {
      "vi": "/θ/: thổi hơi nhẹ qua khe giữa lưỡi và răng, không rung cổ. Đừng đọc như \"th\" của \"thở\".",
      "en": "/θ/: blow a gentle stream of air over the tongue and teeth with no voice. Do not say it like the Vietnamese \"th\" in \"thở\"."
    },
    {
      "vi": "/ð/: giữ nguyên vị trí lưỡi nhưng rung cổ. Đặt tay lên cổ khi nói this, that: phải thấy rung.",
      "en": "/ð/: keep the same tongue position but add voice. With a hand on your throat, you should feel buzzing in this and that."
    },
    {
      "vi": "Rút lưỡi về nhanh sau khi nói; không cắn hay ép lưỡi mạnh.",
      "en": "Pull the tongue back quickly afterwards; do not bite or press hard."
    }
  ],
