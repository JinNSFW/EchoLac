{
  "id": "U09",
  "level": "B1",
  "band": "B1",
  "category": "s_ed_ending",
  "kind": "segmental",
  "prereq": [
    "U02"
  ],
  "title": {
    "vi": "Đuôi -ed: /t d ɪd/",
    "en": "Past -ed endings"
  },
  "cando": {
    "vi": "Em chọn và nói đúng đuôi -ed: /t/, /d/ hoặc /ɪd/.",
    "en": "I can choose and say the right -ed ending: /t/, /d/ or /ɪd/."
  },
  "why": [
    {
      "vi": "Tiếng Việt không chia động từ theo thì, nên đuôi -ed thường bị bỏ khi nói tiếng Anh: walked nghe như walk. Các nghiên cứu về đuôi -ed của học sinh Việt được báo cáo là thường gặp lỗi bỏ đuôi, nhất là sau phụ âm.",
      "en": "Vietnamese does not mark tense on verbs, so -ed is often dropped in English: walked sounds like walk. Studies of Vietnamese learners' -ed are reported to commonly find ending omission, especially after consonants.",
      "refs": [
        "[13]",
        "[14]"
      ]
    },
    {
      "vi": "Đuôi -ed có ba cách đọc và cách chọn theo quy tắc đơn giản: /ɪd/ sau t, d; /t/ sau các âm vô thanh khác; /d/ sau nguyên âm và âm hữu thanh.",
      "en": "The -ed ending has three sounds and the choice follows a simple rule: /ɪd/ after t, d; /t/ after other voiceless sounds; /d/ after vowels and voiced sounds.",
      "refs": [
        "[B16]"
      ]
    },
    {
      "vi": "Thiếu đuôi -ed làm người nghe không biết việc xảy ra khi nào; đây là điểm ưu tiên cao (P1) để người nghe hiểu mình.",
      "en": "A missing -ed leaves the listener unsure when something happened; this is a high-priority (P1) point for being understood.",
      "refs": [
        "[B15]"
      ]
    }
  ],
  "howTo": [
    {
      "vi": "Quy tắc 1: sau t hoặc d, -ed là một âm tiết mới /ɪd/ (wanted, needed). Đếm nhịp: want-ed có hai nhịp.",
      "en": "Rule 1: after t or d, -ed is a new syllable /ɪd/ (wanted, needed). Count beats: want-ed has two."
    },
    {
      "vi": "Quy tắc 2: sau âm vô thanh (k, p, ch, s, f) chỉ thêm /t/ ngắn, không rung cổ (walked, stopped, watched).",
      "en": "Rule 2: after a voiceless sound (k, p, ch, s, f) add only a short /t/ with no voice (walked, stopped, watched)."
    },
    {
      "vi": "Quy tắc 3: sau nguyên âm hoặc âm hữu thanh thêm /d/; đặt tay lên cổ phải thấy rung (played, cleaned, rained).",
      "en": "Rule 3: after a vowel or voiced sound add /d/; a hand on your throat should feel a buzz (played, cleaned, rained)."
    },
    {
      "vi": "Chạm đầu lưỡi lên nướu sau răng trên để đóng /t/ hoặc /d/ rồi thả nhẹ. Đừng dừng ở cổ họng.",
      "en": "Touch the tongue tip to the ridge behind the top teeth for /t/ or /d/, then release lightly. Do not stop in the throat."
    }
  ],
