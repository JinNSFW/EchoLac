{
  "id": "U04",
  "level": "A1",
  "band": "A1-A2",
  "category": "sibilant",
  "kind": "segmental",
  "prereq": [],
  "title": {
    "vi": "Âm /ʃ tʃ dʒ/ khác /s z/",
    "en": "Sh, ch and j sounds"
  },
  "cando": {
    "vi": "Em phân biệt được ship và sip, và nói rõ /ʃ tʃ dʒ/.",
    "en": "I can tell ship from sip and say /ʃ tʃ dʒ/."
  },
  "why": [
    {
      "vi": "Tiếng Việt không có /ʃ ʒ tʃ dʒ/. Chữ \"ch\" của tiếng Việt là âm tắc, không phải /tʃ/; vì vậy cheese dễ thành \"tiz\" hoặc \"shiz\", và /ʃ/ thường được đọc thành /s/ (ship → \"sip\").",
      "en": "Vietnamese has no /ʃ ʒ tʃ dʒ/. The Vietnamese \"ch\" is a stop, not /tʃ/, so cheese easily becomes \"tiz\" or \"shiz\", and /ʃ/ is often said as /s/ (ship → \"sip\").",
      "refs": [
        "[5]",
        "[6]"
      ]
    },
    {
      "vi": "Một luận văn dùng 58 cặp tối thiểu (/tʃ–dʒ/, /s–ʃ/) để đo và cho thấy các cặp này thường bị lẫn ở người học Việt.",
      "en": "A thesis used 58 minimal pairs (/tʃ–dʒ/, /s–ʃ/) and found these pairs are often confused by Vietnamese learners.",
      "refs": [
        "[7]"
      ]
    },
    {
      "vi": "Phân biệt /ʃ tʃ dʒ/ với /s z/ làm đổi nghĩa (ship/sip, chip/ship, job), nên bài này có mức ưu tiên cao (P1).",
      "en": "Telling /ʃ tʃ dʒ/ from /s z/ changes meaning (ship/sip, chip/ship, job), so this unit has high priority (P1).",
      "refs": [
        "[B16]"
      ]
    }
  ],
  "howTo": [
    {
      "vi": "/ʃ/: môi hơi chu tròn, lưỡi lùi lại so với /s/, thổi \"shhh\" như khi bảo ai đó giữ im lặng.",
      "en": "/ʃ/: round the lips slightly, pull the tongue back from where /s/ is, and blow \"shhh\" like asking for quiet."
    },
    {
      "vi": "/s/: môi bẹt, lưỡi sát răng, thổi \"sss\" mảnh và sắc. So sánh với /ʃ/: lưỡi tiến ra trước hơn.",
      "en": "/s/: spread lips, tongue close to the teeth, thin sharp \"sss\". Compare /ʃ/: the tongue is further forward."
    },
    {
      "vi": "/tʃ/: bắt đầu như /t/ (lưỡi chạm nướu), rồi thả ra thành /ʃ/ trong một nhịp: \"t-sh\". Tiếng Việt \"ch\" không có luồng hơi xì này.",
      "en": "/tʃ/: start like /t/ (tongue on the ridge), then release into /ʃ/ in one beat: \"t-sh\". Vietnamese \"ch\" has no hissing release."
    },
    {
      "vi": "/dʒ/: làm giống /tʃ/ nhưng rung cổ, như chữ \"j\" ở đầu job. Đừng đọc thành \"z\" hoặc \"gi\".",
      "en": "/dʒ/: do the same as /tʃ/ but with voice, like the \"j\" at the start of job. Do not say \"z\" or \"gi\"."
    }
  ],
