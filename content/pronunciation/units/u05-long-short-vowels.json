{
  "id": "U05",
  "level": "A2",
  "band": "A1-A2",
  "category": "vowel_length",
  "kind": "segmental",
  "prereq": [],
  "title": {
    "vi": "Nguyên âm /iː–ɪ/, /uː–ʊ/",
    "en": "Long and short vowels"
  },
  "cando": {
    "vi": "Em nói khác nhau ship–sheep và full–fool.",
    "en": "I can make ship–sheep and full–fool sound different."
  },
  "why": [
    {
      "vi": "Tiếng Việt không dùng độ dài nguyên âm để phân biệt nghĩa, nên ship và sheep dễ nghe giống nhau, và full gần với fool.",
      "en": "Vietnamese does not use vowel length to tell words apart, so ship and sheep easily sound alike and full sounds like fool.",
      "refs": [
        "[10]",
        "[11]"
      ]
    },
    {
      "vi": "Một luận văn đo âm thanh (20 người) cho biết sự khác nhau giữa các cặp này chủ yếu nằm ở chất lượng nguyên âm (độ căng, vị trí lưỡi), không chỉ ở độ dài.",
      "en": "A thesis with acoustic measurements (20 speakers) reports that these pairs differ mainly in vowel quality (tenseness, tongue position), not only in length.",
      "refs": [
        "[11]"
      ]
    },
    {
      "vi": "Độ dài và chất lượng nguyên âm được xem là một phần cốt lõi của việc hiểu nhau trong tiếng Anh quốc tế, nên bài này có mức ưu tiên cao (P1).",
      "en": "Vowel length and quality are treated as part of the core for mutual intelligibility in international English, so this unit has high priority (P1).",
      "refs": [
        "[B16]"
      ]
    }
  ],
  "howTo": [
    {
      "vi": "/iː/ (sheep): kéo môi sang hai bên như cười nhẹ, lưỡi nâng cao ở phía trước, giữ âm lâu hơn một chút.",
      "en": "/iː/ (sheep): spread the lips as in a gentle smile, raise the front of the tongue high, and hold the sound a bit longer."
    },
    {
      "vi": "/ɪ/ (ship): thả lỏng môi, lưỡi thấp hơn một chút, nói ngắn và nhanh. Đừng cười.",
      "en": "/ɪ/ (ship): relax the lips, let the tongue sit a little lower, and say it short and quick. Do not smile."
    },
    {
      "vi": "/uː/ (fool): chu môi tròn nhỏ, nâng cuối lưỡi lên cao, giữ âm lâu hơn một chút.",
      "en": "/uː/ (fool): push the lips into a small round shape, raise the back of the tongue high, and hold the sound a bit longer."
    },
    {
      "vi": "/ʊ/ (full): môi tròn nhưng lỏng hơn, hàm thả lỏng, nói ngắn.",
      "en": "/ʊ/ (full): lips round but looser, jaw relaxed, say it short."
    },
    {
      "vi": "Luyện theo cặp trước gương: ship – sheep, full – fool. Môi phải thay đổi hình dạng giữa hai từ.",
      "en": "Practise in pairs in front of a mirror: ship – sheep, full – fool. Your lips should change shape between the two words."
    }
  ],
