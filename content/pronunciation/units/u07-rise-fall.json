  "contrasts": [
    {
      "id": "U07-c01",
      "wrongText": "It's hot? ↘ (giọng đi xuống)",
      "rightText": "It's hot? ↗ (giọng đi lên)",
      "note": {
        "vi": "Câu hỏi có/không mà xuống giọng nghe như câu khẳng định. Kéo giọng lên ở từ cuối: hot↗.",
        "en": "A yes/no question that falls sounds like a statement. Lift your voice on the last word: hot↗."
      }
    },
    {
      "id": "U07-c02",
      "wrongText": "Where is the bridge? ↗",
      "rightText": "Where is the bridge? ↘",
      "note": {
        "vi": "Câu hỏi có từ để hỏi (where, what, how) thường xuống giọng ở cuối. Đừng lên giọng như câu hỏi có/không.",
        "en": "Wh-questions (where, what, how) usually fall at the end. Do not rise as in a yes/no question."
      }
    },
    {
      "id": "U07-c03",
      "wrongText": "I LIKE THE NIGHT MAR-KET (mỗi tiếng một thanh)",
      "rightText": "I like the night MARket ↘",
      "note": {
        "vi": "Đừng đặt dấu thanh tiếng Việt lên từng tiếng. Giữ giọng đều, chỉ có một chỗ xuống giọng rõ ở từ chính cuối câu.",
        "en": "Do not put a Vietnamese tone on every syllable. Keep the voice smooth with one clear fall on the main word at the end."
      }
    }
  ],
  "chain": [
    {
      "text": "It's hot. / It's hot?",
      "shadow": [
        {
          "vi": "Nghe câu mẫu hai lần, chỉ chú ý giọng đi lên hay đi xuống ở cuối.",
          "en": "Listen to the model twice and notice only whether the voice goes up or down at the end."
        },
        {
          "vi": "Ngân nga (hum) đúng hình dạng đường giọng, không nói chữ.",
          "en": "Hum the shape of the tune without words."
        },
        {
          "vi": "Thì thầm cùng lúc với âm thanh mẫu, bắt chước hình dạng, không bắt chước giọng.",
          "en": "Whisper along with the audio, copying the shape, not the voice."
        },
        {
          "vi": "Nói thành tiếng cùng với âm thanh mẫu; nhìn đường cao độ và khớp hình dạng.",
          "en": "Speak aloud with the audio; watch the pitch line and match its shape."
        },
        {
          "vi": "Nói một mình, không có âm thanh; so sánh với đường cao độ của mẫu.",
          "en": "Speak alone with no audio; compare with the model pitch line."
        }
      ],
      "note": {
        "vi": "Bắt chước hình dạng đường cao độ, không bắt chước giọng của người nói mẫu.",
        "en": "Copy the shape of the pitch line, not the model speaker's voice."
      }
    }
  ],
  "selfCheck": {
    "threshold": 80,
    "itemsToPass": 0.8,
    "perceptionToPass": 0.8,
    "gate": "score",
    "vi": "Ghi âm \"It's hot.\" và \"It's hot?\", rồi nghe lại: câu kể đi xuống và câu hỏi đi lên chưa? Với câu hỏi Wh (Where is the market?) giọng có đi xuống không?",
    "en": "Record \"It's hot.\" and \"It's hot?\" and listen back: does the statement fall and the question rise? Does a wh-question (Where is the market?) fall?"
  },
  "teacherNotes": {
    "vi": "Một số người nói phương ngữ có thanh điệu khác nhau nên đường cao độ ở cuối câu có thể khác; đừng cho đó là lỗi nếu người nghe vẫn nhận ra câu kể hay câu hỏi. Người bản ngữ cũng lên giọng ở câu Wh trong một số ngữ cảnh. Phần mềm chỉ ước lượng hướng lên/xuống ở cuối câu (độ tin cậy trung bình, chưa đo trên học sinh thật) và vị trí từ chính (độ tin cậy thấp); không đánh giá cảm xúc hay ý nghĩa. Các mục \"đối chiếu\" chỉ minh hoạ âm cuối, vì giọng lên/xuống không biểu diễn được bằng IPA.",
    "en": "Speakers of some dialects have different tones, so the end-of-sentence pitch can differ; do not count it as an error if the listener still hears a statement or a question. Native speakers also rise on wh-questions in some contexts. The app only estimates final rise or fall (medium confidence, not yet measured on real students) and the nucleus word (low confidence); it cannot judge attitude or meaning. The contrast items only illustrate final sounds, because rises and falls cannot be written in IPA."
  },
  "verified": true,
  "reviewedBy": "Giáo viên A",
  "reviewedAt": "2026-11-22"
}
