{
  "id": "U02",
  "level": "A1",
  "band": "A1-A2",
  "category": "s_ed_ending",
  "kind": "segmental",
  "prereq": [
    "U01"
  ],
  "title": {
    "vi": "Đuôi -s: /s z ɪz/",
    "en": "Plural and -s endings"
  },
  "cando": {
    "vi": "Em nói được đuôi -s của danh từ số nhiều và động từ ngôi thứ ba số ít.",
    "en": "I can say plural and he/she -s endings."
  },
  "why": [
    {
      "vi": "Tiếng Việt không chia từ (không có số nhiều hay -s ngôi thứ ba), nên đuôi -s dễ bị bỏ. Một nghiên cứu (16 bài nói độc thoại) thấy khoảng 28,4% /s z/ cuối bị bỏ, và hơn một nửa (50,7%) khi đứng sau một phụ âm khác.",
      "en": "Vietnamese does not inflect words (no plural or third-person -s), so the -s ending is easily dropped. One study (16 monologues) found about 28.4% of final /s z/ omitted, and over half (50.7%) when it followed another consonant.",
      "refs": [
        "[2]"
      ]
    },
    {
      "vi": "-s ngữ pháp (books, goes) bị bỏ nhiều hơn /s/ nằm trong từ (như bus). Vì vậy cần luyện riêng đuôi -s, nhưng ở đây ta xem nó là lỗi phát âm của một từ đã biết, không phải lỗi ngữ pháp.",
      "en": "A grammatical -s (books, goes) is omitted more often than an /s/ inside a word (like bus). So the ending needs its own practice, but here we treat it as a pronunciation error on a known word, not a grammar error.",
      "refs": [
        "[2]"
      ]
    },
    {
      "vi": "Âm tiết tiếng Việt chuẩn không có /s z/ ở cuối; /z/ của bags hay bees còn hay bị đọc thành /s/. Hai điều này được báo cáo ở người nói tiếng Việt miền Bắc.",
      "en": "Standard Vietnamese syllables have no final /s z/, and the /z/ of bags or bees is often said as /s/. Both are reported for Northern Vietnamese speakers.",
      "refs": [
        "[14]",
        "[12]"
      ]
    }
  ],
  "howTo": [
    {
      "vi": "Sau âm vô thanh (p, t, k, f, θ) đuôi là /s/ không rung: books, maps, cats, bikes.",
      "en": "After a voiceless sound (p, t, k, f, θ) the ending is a voiceless /s/: books, maps, cats, bikes."
    },
    {
      "vi": "Sau nguyên âm hoặc âm hữu thanh (b, ɡ, m, n, l) đuôi là /z/: đặt tay lên cổ, phải thấy rung: bags, rooms, trees, goes.",
      "en": "After a vowel or voiced sound the ending is /z/. Feel the buzz with a hand on your throat: bags, rooms, goes."
    },
    {
      "vi": "Sau âm xì hoặc /tʃ dʒ/ (s, z, ʃ, tʃ, dʒ) thêm một âm tiết ngắn /ɪz/: bridges, beaches, dishes.",
      "en": "After a hissing sound or /tʃ dʒ/ (s, z, ʃ, tʃ, dʒ) add a short extra syllable /ɪz/: bridges, beaches, dishes."
    },
    {
      "vi": "Nói từ gốc rồi kéo thẳng sang \"sss\" hoặc \"zzz\", không ngắt và không thêm \"ờ\".",
      "en": "Say the base word, then slide straight into \"sss\" or \"zzz\" with no break and no extra \"uh\"."
    }
  ],
